# Web (public values)
VITE_SUPABASE_URL=https://tywmpjhfvaoqhpalevto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_URL=https://cvtailor.pages.dev

# Supabase Edge Function secrets (set with `supabase secrets set`)
OPENAI_API_KEY=replace_me
# Required for the public OpenAI response webhook. Copy the signing secret shown when the endpoint is created.
OPENAI_WEBHOOK_SECRET=replace_me
OPENAI_MODEL=gpt-6.1-sol
# Optional: use a separate model for bounded interview voice transcription.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional: use a separate model for automatic job extraction. Falls back to OPENAI_MODEL.
OPENAI_JOB_MODEL=gpt-6.1-sol
JOB_PARSE_DAILY_LIMIT=50
# Required by the private scheduled job-finalization endpoint. Use a separate random value and store the same value in Supabase Vault.
JOB_FINALIZER_SECRET=replace_with_a_long_random_value
ALLOWED_ORIGINS=http://localhost:5173,https://cvtailor.pages.dev

# Chrome extension build
VITE_WEB_APP_URL=https://cvtailor.pages.dev
