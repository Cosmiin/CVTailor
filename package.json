{
  "name": "cv-maker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm --filter @cv-maker/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @cv-maker/web build",
    "build:extension": "pnpm --filter @cv-maker/extension build",
    "package:extension": "pnpm build:extension && node scripts/package-extension.mjs",
    "deploy:cloudflare": "pnpm package:extension && pnpm build:web && wrangler pages deploy apps/web/dist --project-name cvtailor --branch main",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "supabase": "^2.121.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.0"
  }
}
